# Database (matches docker-compose.yml)
DATABASE_URL="postgresql://farmstory:farmstory@localhost:5432/farmstory?schema=public"

PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# AI assistant (optional). Without a key the assistant shows a graceful unavailable state.
AI_API_KEY=
AI_MODEL=claude-sonnet-4-6

# Authentication (farmer accounts). REQUIRED in production; use a long random value, e.g. `openssl rand -base64 48`.
JWT_SECRET=
# Cookie SameSite policy: "lax" (default; frontend and API on the same site / via the dev proxy) or "none" (cross-site deployments; forces Secure).
COOKIE_SAME_SITE=lax
