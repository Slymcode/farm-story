{
  "name": "farm-story-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "test": "jest",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "seed": "ts-node prisma/seed.ts"
  },
  "prisma": { "seed": "ts-node prisma/seed.ts" },
  "jest": {
    "moduleFileExtensions": ["js", "json", "ts"],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": { "^.+\\.(t|j)s$": ["ts-jest", { "diagnostics": false }] },
    "testEnvironment": "node"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0", "@nestjs/core": "^11.0.0", "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.0.0", "@nestjs/config": "^4.0.0",
    "@prisma/client": "6.19.3", "@prisma/adapter-pg": "6.19.3", "pg": "^8.13.0",
    "reflect-metadata": "^0.2.2", "rxjs": "^7.8.1", "class-validator": "^0.14.1", "class-transformer": "^0.5.1",
    "@anthropic-ai/sdk": "latest", "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "typescript": "~5.9.3", "@nestjs/cli": "^11.0.0", "@nestjs/testing": "^11.0.0", "@nestjs/schematics": "^11.0.0",
    "@types/node": "^22.0.0", "@types/express": "^5.0.0", "@types/jest": "^29.5.0", "@types/pg": "^8.11.0",
    "jest": "^29.7.0", "ts-jest": "^29.2.0", "ts-node": "^10.9.2", "prisma": "6.19.3"
  }
}
